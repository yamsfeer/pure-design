# 依赖
node_modules/

# 生成产物（agent 输出的 HTML 不进仓库）
/output/*
# 例外：can-i-deploy.html 是手工设计的展示稿（非 agent 生成物），保留在仓库
!/output/can-i-deploy.html

# 一键脚本传服务器的临时提示词
/.brief.txt

# 上游原仓库（只读参考，体积 533M，不提交）
/upstream/

# 本地环境与凭据
.env
.env.local
*.pem
*_key.pem
*_key.pub
*.key
!id_rsa.pub

# 系统文件
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
/tmp/
